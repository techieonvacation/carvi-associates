  showNote           Boolean  @default(true)
  socialsTitle       String   @default("follow us:")
  showSocials        Boolean  @default(true)
  whatsappLabel      String
  whatsappHref       String
  whatsappIntroText  String   @default("For more updates follow 👉")
  whatsappLinkText   String   @default("CARVI AND ASSOCIATES on Whatsapp")
  showWhatsappNotice Boolean  @default(true)
  updatedAt          DateTime @updatedAt
}

model HeroSettings {
  id               String   @id @default("default")
  tagline          String
  titleBeforeVideo String
  titleHighlight   String
  titleAfterVideo  String
  description      String   @default("Expertise in Audit, Tax, Compliance & Advisory to help you stay compliant, reduce risks and scale your business.")
