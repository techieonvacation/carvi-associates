model SeoPage {
  id                 String              @id @default(cuid())
  path               String              @unique
  label              String              @default("")
  title              String?
  description        String?
  keywords           String?
  canonicalUrl       String?
  ogTitle            String?
  ogDescription      String?
  ogImageUrl         String?
  ogImageAlt         String?
  ogType             String?
  twitterTitle       String?
  twitterDescription String?
  twitterImageUrl    String?
  twitterCard        SeoTwitterCard?
  noIndex            Boolean             @default(false)
  noFollow           Boolean             @default(false)
  noArchive          Boolean             @default(false)
  noSnippet          Boolean             @default(false)
  noImageIndex       Boolean             @default(false)
  maxSnippet         Int?
  maxImagePreview    SeoImagePreview?
  maxVideoPreview    Int?
  breadcrumbLabel    String?
  focusKeyword       String              @default("")
  secondaryKeywords  String              @default("")
  aiSummary          String              @default("")
  speakableSelectors Json                @default("[]")
  hreflangEntries    Json                @default("[]")
  customJsonLd       Json?
  includeInSitemap   Boolean             @default(true)
  sitemapPriority    Float?
  sitemapChangeFreq  SeoChangeFrequency?
  sitemapLastMod     DateTime?
  notes              String              @default("")
  displayOrder       Int                 @default(0)
  isActive           Boolean             @default(true)
  deletedAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([displayOrder])
  @@index([deletedAt])
  @@index([isActive, deletedAt])
}

model SeoRedirect {
  id            String           @id @default(cuid())
  source        String           @unique
  destination   String
  statusCode    Int              @default(308)
  matchType     SeoRedirectMatch @default(EXACT)
  preserveQuery Boolean          @default(true)
  hitCount      Int              @default(0)
  lastHitAt     DateTime?
  notes         String           @default("")
  isActive      Boolean          @default(true)
  displayOrder  Int              @default(0)
  deletedAt     DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([isActive, deletedAt])
  @@index([displayOrder])
}

model SeoScript {
  id              String             @id @default(cuid())
  name            String
  description     String             @default("")
  placement       SeoScriptPlacement @default(HEAD)
  strategy        SeoScriptStrategy  @default(AFTER_INTERACTIVE)
  scriptSrc       String             @default("")
  inlineCode      String             @default("")
  scriptType      String             @default("")
  isAsync         Boolean            @default(false)
  isDefer         Boolean            @default(false)
  attributes      Json               @default("[]")
  scope           SeoScriptScope     @default(ALL)
  pathPatterns    Json               @default("[]")
  consentCategory SeoConsentCategory @default(ANALYTICS)
  isActive        Boolean            @default(true)
  displayOrder    Int                @default(0)
  deletedAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([displayOrder])
  @@index([isActive, deletedAt])
}

model SeoIntegration {
  id           String                 @id @default(cuid())
  provider     SeoIntegrationProvider
  label        String                 @default("")
  trackingId   String                 @default("")
  secondaryId  String                 @default("")
  config       Json                   @default("{}")
  notes        String                 @default("")
  isActive     Boolean                @default(true)
  displayOrder Int                    @default(0)
  deletedAt    DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([provider])
  @@index([displayOrder])
  @@index([isActive, deletedAt])
}

model SeoRobotsRule {
  id            String    @id @default(cuid())
  userAgent     String
  allowPaths    Json      @default("[]")
  disallowPaths Json      @default("[]")
  crawlDelay    Int?
  notes         String    @default("")
  isActive      Boolean   @default(true)
  displayOrder  Int       @default(0)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([displayOrder])
  @@index([isActive, deletedAt])
}

model SeoSitemapEntry {
  id              String             @id @default(cuid())
  url             String             @unique
  changeFrequency SeoChangeFrequency @default(MONTHLY)
  priority        Float              @default(0.5)
  lastModified    DateTime?
  imageUrls       Json               @default("[]")
  notes           String             @default("")
  isActive        Boolean            @default(true)
  displayOrder    Int                @default(0)
  deletedAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([displayOrder])
  @@index([isActive, deletedAt])
}

model SeoFaq {
  id           String       @id @default(cuid())
  question     String
  answer       String
  scope        SeoScopeKind @default(GLOBAL)
  pagePath     String       @default("")
  category     String       @default("")
  keywords     String       @default("")
  isSpeakable  Boolean      @default(true)
  showOnPage   Boolean      @default(true)
  displayOrder Int          @default(0)
  isActive     Boolean      @default(true)
  isVisible    Boolean      @default(true)
  deletedAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([displayOrder])
  @@index([scope, pagePath])
  @@index([isActive, deletedAt])
}

model SeoSchema {
  id           String       @id @default(cuid())
  name         String
  schemaType   String       @default("Organization")
  jsonLd       Json         @default("{}")
  scope        SeoScopeKind @default(GLOBAL)
  pagePath     String       @default("")
  notes        String       @default("")
  isActive     Boolean      @default(true)
  displayOrder Int          @default(0)
  deletedAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([displayOrder])
  @@index([scope, pagePath])
  @@index([isActive, deletedAt])
}
