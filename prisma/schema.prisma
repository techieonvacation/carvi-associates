generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(MANAGER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model NavItem {
  id        String   @id @default(cuid())
  label     String
  href      String
  sortOrder Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model SocialLink {
  id        String   @id @default(cuid())
  label     String
  href      String
  icon      String
  sortOrder Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model TopbarSettings {
  id                   String   @id @default("default")
  email                String
  address              String
  addressMapUrl        String
  phone                String
  phoneHref            String
  whatsappLabel        String
  whatsappHref         String
  whatsappMarqueeText  String   @default("Join our WhatsApp Channel for daily tax, GST & compliance updates")
  whatsappMarqueeSpeed Int      @default(22)
  showWhatsappMarquee  Boolean  @default(true)
  updatedAt            DateTime @updatedAt
}

model HeroSettings {
  id               String   @id @default("default")
  tagline          String
  titleBeforeVideo String
  titleHighlight   String
  titleAfterVideo  String
  description      String   @default("Expertise in Audit, Tax, Compliance & Advisory to help you stay compliant, reduce risks and scale your business.")
  secondaryCtaText String   @default("Talk to an Expert")
  ctaText          String
  ctaHref          String
  videoId          String?
  heroImageUrl     String
  activeUserCount  Int      @default(125)
  activeUserSuffix String   @default("k+")
  activeUserLabel  String   @default("Active Users")
  activeUserImages Json     @default("[]")
  stats            Json     @default("[]")
  trust            Json     @default("[]")
  updatedAt        DateTime @updatedAt
}

model HeaderSettings {
  id             String   @id @default("default")
  contactCtaText String   @default("Contact Us")
  contactCtaHref String   @default("#")
  updatedAt      DateTime @updatedAt
}

model PartnerMarqueeSettings {
  id        String   @id @default("default")
  label     String
  updatedAt DateTime @updatedAt
}

model Partner {
  id        String   @id @default(cuid())
  name      String
  tagline   String?
  logoUrl   String?
  variant   String   @default("default")
  sortOrder Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model Feature {
  id        String   @id @default(cuid())
  icon      String
  title     String
  text      String
  href      String   @default("#")
  sortOrder Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model AboutSettings {
  id              String   @id @default("default")
  tagline         String
  titleLine1      String
  titleLine2      String
  text            String
  experienceValue String
  experienceLabel String
  collageOneUrl   String
  collageTwoUrl   String
  collageOneAlt   String   @default("Advisors reviewing a financial plan")
  collageTwoAlt   String   @default("Client consultation in progress")
  defaultTabId    String?
  taglineBg       String   @default("#f4ebd8")
  tabs            Json     @default("[]")
  checklist       Json     @default("[]")
  updatedAt       DateTime @updatedAt
}

model Media {
  id          String    @id @default(cuid())
  url         String
  publicId    String?
  alt         String    @default("")
  caption     String    @default("")
  credit      String    @default("")
  width       Int?
  height      Int?
  mimeType    String?
  blurDataUrl String?
  folder      String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([deletedAt])
  @@index([createdAt])
}

model ServicesSectionSettings {
  id              String   @id @default("default")
  tagline         String
  titleLine1      String
  titleLine2      String
  cardTagline     String
  taglineBg       String   @default("#fffdf8")
  isVisible       Boolean  @default(true)
  seoTitle        String?
  seoDescription  String?
  seoKeywords     String?
  canonicalUrl    String?
  ogImageUrl      String?
  twitterImageUrl String?
  noIndex         Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

model Service {
  id             String    @id @default(cuid())
  titleLine1     String
  titleLine2     String
  shortTitle     String?
  subtitle       String?
  description    String
  slug           String?   @unique
  icon           String
  iconType       String    @default("icomoon")
  imageUrl       String
  imageAlt       String    @default("")
  hoverImageUrl  String?
  badge          String?
  category       String?
  serviceType    String?
  accentColor    String?
  ctaText        String    @default("Learn more")
  ctaHref        String    @default("#")
  displayOrder   Int       @default(0)
  isFeatured     Boolean   @default(false)
  isPopular      Boolean   @default(false)
  isActive       Boolean   @default(true)
  isVisible      Boolean   @default(true)
  publishedAt    DateTime?
  deletedAt      DateTime?
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  canonicalUrl   String?
  ogImageUrl     String?
  noIndex        Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([displayOrder])
  @@index([deletedAt])
  @@index([isVisible, isActive, deletedAt])
}

model BookAppointmentSettings {
  id                  String   @id @default("default")
  tagline             String
  titleLine1          String
  titleLine2          String
  description         String
  primaryButtonText   String   @default("Get Started")
  primaryButtonHref   String   @default("#")
  secondaryButtonText String   @default("Contact Now")
  secondaryButtonHref String   @default("#")
  backgroundImageUrl  String
  backgroundImageAlt  String   @default("")
  taglineBg           String   @default("#f4ebd8")
  isVisible           Boolean  @default(true)
  seoTitle            String?
  seoDescription      String?
  seoKeywords         String?
  canonicalUrl        String?
  ogImageUrl          String?
  twitterImageUrl     String?
  noIndex             Boolean  @default(false)
  updatedAt           DateTime @updatedAt
}

model WhyChooseSettings {
  id               String   @id @default("default")
  tagline          String
  titleLine1       String
  titleLine2       String
  description      String
  taglineBg        String   @default("#f4ebd8")
  imageUrl         String
  imageAlt         String   @default("Why choose Carvi Associates")
  shapeImageUrl    String   @default("/images/shapes/why-choose-shape-1-1.png")
  imageFit         String   @default("cover")
  imageMinHeightPx Int      @default(560)
  showImageShape   Boolean  @default(true)
  isVisible        Boolean  @default(true)
  seoTitle         String?
  seoDescription   String?
  seoKeywords      String?
  canonicalUrl     String?
  ogImageUrl       String?
  twitterImageUrl  String?
  noIndex          Boolean  @default(false)
  updatedAt        DateTime @updatedAt
}

model WhyChooseItem {
  id           String    @id @default(cuid())
  icon         String
  title        String
  text         String
  href         String    @default("#")
  displayOrder Int       @default(0)
  isVisible    Boolean   @default(true)
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([displayOrder])
  @@index([deletedAt])
  @@index([isVisible, isActive, deletedAt])
}

model TeamSettings {
  id              String   @id @default("default")
  tagline         String
  titleLine1      String
  titleLine2      String
  taglineBg       String   @default("#f4ebd8")
  isVisible       Boolean  @default(true)
  seoTitle        String?
  seoDescription  String?
  seoKeywords     String?
  canonicalUrl    String?
  ogImageUrl      String?
  twitterImageUrl String?
  noIndex         Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

model TeamMember {
  id           String    @id @default(cuid())
  name         String
  role         String
  imageUrl     String
  imageAlt     String    @default("")
  href         String    @default("#")
  socials      Json      @default("[]")
  displayOrder Int       @default(0)
  isVisible    Boolean   @default(true)
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([displayOrder])
  @@index([deletedAt])
  @@index([isVisible, isActive, deletedAt])
}

model WorkingProcessSettings {
  id              String   @id @default("default")
  tagline         String
  titleLine1      String
  titleLine2      String
  taglineBg       String   @default("#f4ebd8")
  isVisible       Boolean  @default(true)
  seoTitle        String?
  seoDescription  String?
  seoKeywords     String?
  canonicalUrl    String?
  ogImageUrl      String?
  twitterImageUrl String?
  noIndex         Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

model WorkingProcessStep {
  id           String    @id @default(cuid())
  stepLabel    String
  title        String
  text         String
  imageUrl     String
  imageAlt     String    @default("")
  href         String    @default("#")
  displayOrder Int       @default(0)
  isVisible    Boolean   @default(true)
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([displayOrder])
  @@index([deletedAt])
  @@index([isVisible, isActive, deletedAt])
}

enum FooterLinkColumn {
  LINKS_ONE
  LINKS_TWO
  EXPLORE
  BOTTOM
}

model FooterSettings {
  id                 String   @id @default("default")
  about              String
  backgroundImageUrl String
  watermarkText      String   @default("CARVI ASSOCIATES")
  showWatermark      Boolean  @default(true)
  copyrightText      String   @default("by Carvi Associates.")
  linksTitle         String   @default("Links")
  exploreTitle       String   @default("Explore")
  blogTitle          String   @default("Recent Blog")
  showAbout          Boolean  @default(true)
  showSocials        Boolean  @default(true)
  showLinks          Boolean  @default(true)
  showExplore        Boolean  @default(true)
  showRecentBlog     Boolean  @default(true)
  showBottomBar      Boolean  @default(true)
  useSiteSocials     Boolean  @default(true)
  logoTone           String   @default("dark")
  isVisible          Boolean  @default(true)
  seoTitle           String?
  seoDescription     String?
  seoKeywords        String?
  canonicalUrl       String?
  ogImageUrl         String?
  twitterImageUrl    String?
  noIndex            Boolean  @default(false)
  updatedAt          DateTime @updatedAt
}

model FooterLink {
  id           String           @id @default(cuid())
  label        String
  href         String           @default("#")
  column       FooterLinkColumn
  displayOrder Int              @default(0)
  isVisible    Boolean          @default(true)
  isActive     Boolean          @default(true)
  deletedAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([column, displayOrder])
  @@index([deletedAt])
}

model FooterRecentPost {
  id           String    @id @default(cuid())
  title        String
  dateLabel    String
  imageUrl     String
  imageAlt     String    @default("")
  href         String    @default("#")
  displayOrder Int       @default(0)
  isVisible    Boolean   @default(true)
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([displayOrder])
  @@index([deletedAt])
}

model FooterSocialLink {
  id           String    @id @default(cuid())
  label        String
  href         String
  icon         String
  displayOrder Int       @default(0)
  isVisible    Boolean   @default(true)
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([displayOrder])
  @@index([deletedAt])
}

enum MarqueeBandTarget {
  ONE
  TWO
  BOTH
}

enum MarqueeItemKind {
  TEXT
  IMAGE
  TEXT_IMAGE
}

model MarqueeSettings {
  id                  String   @id @default("default")
  ariaLabel           String   @default("Practice highlights")
  layout              String   @default("stacked")
  isVisible           Boolean  @default(true)
  showBandOne         Boolean  @default(true)
  showBandTwo         Boolean  @default(true)
  bandOneBgColor      String   @default("#5c6b45")
  bandOneTextColor    String   @default("#fffdf8")
  bandTwoBgColor      String   @default("#e3c9a0")
  bandTwoTextColor    String   @default("#5c6b45")
  bandOneDirection    String   @default("left")
  bandTwoDirection    String   @default("right")
  bandOneSpeedSeconds Int      @default(34)
  bandTwoSpeedSeconds Int      @default(34)
  bandOneSeparatorUrl String   @default("/images/shapes/slidet-text-shape-1.png")
  bandTwoSeparatorUrl String   @default("/images/shapes/slidet-text-shape-2.png")
  showSeparator       Boolean  @default(true)
  skewDegrees         Float    @default(1.5)
  fontSizePx          Int      @default(26)
  itemGapPx           Int      @default(28)
  bandPaddingPx       Int      @default(22)
  alternateOutline    Boolean  @default(true)
  pauseOnHover        Boolean  @default(true)
  updatedAt           DateTime @updatedAt
}

model MarqueeItem {
  id           String            @id @default(cuid())
  kind         MarqueeItemKind   @default(TEXT)
  band         MarqueeBandTarget @default(BOTH)
  text         String            @default("")
  imageUrl     String?
  imageAlt     String            @default("")
  imageWidth   Int               @default(120)
  imageHeight  Int               @default(40)
  href         String?
  outlined     Boolean           @default(false)
  displayOrder Int               @default(0)
  isVisible    Boolean           @default(true)
  isActive     Boolean           @default(true)
  deletedAt    DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([displayOrder])
  @@index([deletedAt])
  @@index([isVisible, isActive, deletedAt])
}

model ProjectsSectionSettings {
  id                       String   @id @default("default")
  tagline                  String
  titleLine1               String
  titleLine2               String
  taglineBg                String   @default("#fffdf8")
  topBackgroundImageUrl    String   @default("/images/shapes/projects-bg-shape-1-1.png")
  bottomBackgroundImageUrl String   @default("/images/shapes/projects-bg-shape-1-2.png")
  showFilters              Boolean  @default(true)
  allFilterLabel           String   @default("All")
  showBottomBanner         Boolean  @default(true)
  bannerStat               String   @default("25,860+")
  bannerTitleLine1         String
  bannerTitleLine2         String
  bannerChecklist          Json     @default("[]")
  bannerButtonText         String   @default("View All Projects")
  bannerButtonHref         String   @default("#")
  isVisible                Boolean  @default(true)
  seoTitle                 String?
  seoDescription           String?
  seoKeywords              String?
  canonicalUrl             String?
  ogImageUrl               String?
  twitterImageUrl          String?
  noIndex                  Boolean  @default(false)
  updatedAt                DateTime @updatedAt
}

model ProjectCategory {
  id           String    @id @default(cuid())
  label        String
  slug         String    @unique
  displayOrder Int       @default(0)
  isVisible    Boolean   @default(true)
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([displayOrder])
  @@index([deletedAt])
}

model ProjectItem {
  id           String    @id @default(cuid())
  title        String
  text         String
  icon         String    @default("icon-business-and-finance")
  imageUrl     String
  imageAlt     String    @default("")
  href         String    @default("#")
  slug         String?   @unique
  categorySlug String?
  tags         Json      @default("[]")
  displayOrder Int       @default(0)
  isFeatured   Boolean   @default(false)
  isVisible    Boolean   @default(true)
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([displayOrder])
  @@index([deletedAt])
  @@index([categorySlug])
  @@index([isVisible, isActive, deletedAt])
}
