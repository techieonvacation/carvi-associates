generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(MANAGER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model NavItem {
  id        String   @id @default(cuid())
  label     String
  href      String
  sortOrder Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model SocialLink {
  id        String   @id @default(cuid())
  label     String
  href      String
  icon      String
  sortOrder Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model TopbarSettings {
  id                 String   @id @default("default")
  email              String
  address            String
  addressMapUrl      String
  phone              String
  phoneHref          String
  whatsappLabel      String
  whatsappHref       String
  whatsappIntroText  String   @default("For more updates follow 👉")
  whatsappLinkText   String   @default("CARVI AND ASSOCIATES on Whatsapp")
  showWhatsappNotice Boolean  @default(true)
  updatedAt          DateTime @updatedAt
}

model HeroSettings {
  id               String   @id @default("default")
  tagline          String
  titleBeforeVideo String
  titleHighlight   String
  titleAfterVideo  String
  description      String   @default("Expertise in Audit, Tax, Compliance & Advisory to help you stay compliant, reduce risks and scale your business.")
  secondaryCtaText String   @default("Talk to an Expert")
  ctaText          String
  ctaHref          String
  videoId          String?
  heroImageUrl     String
  activeUserCount  Int      @default(125)
  activeUserSuffix String   @default("k+")
  activeUserLabel  String   @default("Active Users")
  activeUserImages Json     @default("[]")
  stats            Json     @default("[]")
  trust            Json     @default("[]")
  updatedAt        DateTime @updatedAt
}

model HeaderSettings {
  id                String   @id @default("default")
  contactCtaText    String   @default("Contact Us")
  contactCtaHref    String   @default("#")
  logoVariant       String   @default("wordmark")
  logoImageUrl      String   @default("")
  logoDarkImageUrl  String   @default("")
  logoAlt           String   @default("Carvi Associates")
  logoHref          String   @default("/")
  logoMarkText      String   @default("C")
  logoPrimaryText   String   @default("Carvi")
  logoSecondaryText String   @default("Associates")
  showLogoMark      Boolean  @default(true)
  logoHeightDesktop Int      @default(46)
  logoHeightMobile  Int      @default(36)
  updatedAt         DateTime @updatedAt
}

model PartnerMarqueeSettings {
  id        String   @id @default("default")
  label     String
  updatedAt DateTime @updatedAt
}

model Partner {
  id        String   @id @default(cuid())
  name      String
  tagline   String?
  logoUrl   String?
  variant   String   @default("default")
  sortOrder Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model Feature {
  id        String   @id @default(cuid())
  icon      String
  title     String
  text      String
  href      String   @default("#")
  sortOrder Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model AboutSettings {
  id              String   @id @default("default")
  tagline         String
  titleLine1      String
  titleLine2      String
  text            String
  experienceValue String
  experienceLabel String
  collageOneUrl   String
  collageTwoUrl   String
  collageOneAlt   String   @default("Advisors reviewing a financial plan")
  collageTwoAlt   String   @default("Client consultation in progress")
  defaultTabId    String?
  taglineBg       String   @default("#f4ebd8")
  tabs            Json     @default("[]")
  checklist       Json     @default("[]")
  updatedAt       DateTime @updatedAt
}

model Media {
  id          String    @id @default(cuid())
  url         String
  publicId    String?
  alt         String    @default("")
  caption     String    @default("")
  credit      String    @default("")
  width       Int?
  height      Int?
  mimeType    String?
  blurDataUrl String?
  folder      String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([deletedAt])
  @@index([createdAt])
}

model ServicesSectionSettings {
  id              String   @id @default("default")
  tagline         String
  titleLine1      String
  titleLine2      String
  cardTagline     String
  taglineBg       String   @default("#fffdf8")
  isVisible       Boolean  @default(true)
  seoTitle        String?
  seoDescription  String?
  seoKeywords     String?
  canonicalUrl    String?
  ogImageUrl      String?
  twitterImageUrl String?
  noIndex         Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

model Service {
  id             String    @id @default(cuid())
  titleLine1     String
  titleLine2     String
  shortTitle     String?
  subtitle       String?
  description    String
  slug           String?   @unique
  icon           String
  iconType       String    @default("icomoon")
  imageUrl       String
  imageAlt       String    @default("")
  hoverImageUrl  String?
  badge          String?
  category       String?
  serviceType    String?
  accentColor    String?
  ctaText        String    @default("Learn more")
  ctaHref        String    @default("#")
  displayOrder   Int       @default(0)
  isFeatured     Boolean   @default(false)
  isPopular      Boolean   @default(false)
  isActive       Boolean   @default(true)
  isVisible      Boolean   @default(true)
  publishedAt    DateTime?
  deletedAt      DateTime?
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  canonicalUrl   String?
  ogImageUrl     String?
  noIndex        Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([displayOrder])
  @@index([deletedAt])
  @@index([isVisible, isActive, deletedAt])
}

model BookAppointmentSettings {
  id                  String   @id @default("default")
  tagline             String
  titleLine1          String
  titleLine2          String
  description         String
  primaryButtonText   String   @default("Get Started")
  primaryButtonHref   String   @default("#")
  secondaryButtonText String   @default("Contact Now")
  secondaryButtonHref String   @default("#")
  backgroundImageUrl  String
  backgroundImageAlt  String   @default("")
  taglineBg           String   @default("#f4ebd8")
  isVisible           Boolean  @default(true)
  seoTitle            String?
  seoDescription      String?
  seoKeywords         String?
  canonicalUrl        String?
  ogImageUrl          String?
  twitterImageUrl     String?
  noIndex             Boolean  @default(false)
  updatedAt           DateTime @updatedAt
}

model WhyChooseSettings {
  id               String   @id @default("default")
  tagline          String
  titleLine1       String
  titleLine2       String
  description      String
  taglineBg        String   @default("#f4ebd8")
  imageUrl         String
  imageAlt         String   @default("Why choose Carvi Associates")
  shapeImageUrl    String   @default("/images/shapes/why-choose-shape-1-1.png")
  imageFit         String   @default("cover")
  imageMinHeightPx Int      @default(560)
  showImageShape   Boolean  @default(true)
  isVisible        Boolean  @default(true)
  seoTitle         String?
  seoDescription   String?
  seoKeywords      String?
  canonicalUrl     String?
  ogImageUrl       String?
  twitterImageUrl  String?
