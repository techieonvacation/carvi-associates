enum SeoScriptScope {
  ALL
  INCLUDE
  EXCLUDE
}

enum SeoConsentCategory {
  NECESSARY
  ANALYTICS
  MARKETING
  PREFERENCES
}

enum SeoIntegrationProvider {
  GOOGLE_ANALYTICS
  GOOGLE_TAG_MANAGER
  GOOGLE_ADS
  GOOGLE_SEARCH_CONSOLE
  GOOGLE_OPTIMIZE
  BING_WEBMASTER
  BING_UET
  META_PIXEL
  LINKEDIN_INSIGHT
  TIKTOK_PIXEL
  PINTEREST_TAG
  X_PIXEL
  HOTJAR
  MICROSOFT_CLARITY
  PLAUSIBLE
  FATHOM
  MATOMO
  POSTHOG
  YANDEX_METRICA
  CRISP_CHAT
  TAWK_TO
  INTERCOM
  CUSTOM
}

enum SeoScopeKind {
  GLOBAL
  PAGE
}

enum SeoRedirectMatch {
  EXACT
  PREFIX
  REGEX
}

