model TeamSettings {
  id                 String   @id @default("default")
  tagline            String
  titleLine1         String
  titleLine2         String
  taglineBg          String   @default("#fffdf8")
  backgroundImageUrl String   @default("")
  backgroundImageAlt String   @default("")
